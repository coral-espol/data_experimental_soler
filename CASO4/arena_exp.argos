<argos-configuration>

  <framework>
    <experiment length="10000" ticks_per_second="10" random_seed="35526" />
    <system threads="0" />
  </framework>

  <controllers>
    <lua_controller id="lua">
      <actuators>
        <differential_steering implementation="default" />
        <leds implementation="default" medium="leds" />
      </actuators>
      <sensors>
        <qupa_proximity implementation="default" show_rays="false" />
        <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="true" />
        <ground implementation="rot_z_only" />
      </sensors>
      <params script="/home/gmadro/soler_experiment/control/control_soft.lua" />
    </lua_controller>
  </controllers>
  <loop_functions library="build/libqupa_learning.so" label="qupa_learning" shuffle="false" shape="circle" pattern="midle" task_size="0.15" greedy="false" /> 

  <arena size="3, 3, 1" center="0,0,0.3">

    <floor id="floor" source="loop_functions" pixels_per_meter="100" />
    
    <box id="bn" size="0.05, 2.06, 0.3" movable="false">
      <body position="0.7,0,0" orientation="0,0,0" />
    </box>
    <box id="bs" size="0.05, 2.06, 0.3" movable="false">
      <body position="-0.7,0,0" orientation="0,0,0" />
    </box>
    <box id="be" size="2.4, 0.05, 0.3" movable="false">
      <body position="0,-1.03,0" orientation="0,0,0" />
    </box>
    <box id="bw" size="2.4, 0.05, 0.3" movable="false">
      <body position="0,1.03,0" orientation="0,0,0" />
    </box>

    <box id="bn_borde" size="0.05, 0.2, 0.3" movable="false">
      <body position="0.625,0.95,0" orientation="45,0,0" />
    </box>
    <box id="bs_borde" size="0.05, 0.2, 0.3" movable="false">
      <body position="-0.625,0.95,0" orientation="-45,0,0" />
    </box>
    <box id="be_borde" size="0.2, 0.05, 0.3" movable="false">
      <body position="-0.625,-0.95,0" orientation="-45,0,0" />
    </box>
    <box id="bw_borde" size="0.2, 0.05, 0.3" movable="false">
      <body position="0.625,-0.95,0" orientation="45,0,0" />
    </box>

    <qupa id="q0">
      <body position="-0.152824,0.171179,0" orientation="0,0,0" />
      <controller config="lua" />
    </qupa>
    
    <qupa id="q1">
      <body position="-0.136787,0.446398,0" orientation="0,0,0" />
      <controller config="lua" />
    </qupa>

    <qupa id="q2">
      <body position="0.144871,0.439148,0" orientation="0,0,0" /> 
      <controller config="lua" />
    </qupa>

    <qupa id="q3">
      <body position="-0.466203,0.455464,0" orientation="0,0,0" />
      <controller config="lua" />
    </qupa>

  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" iterations="50" />
  </physics_engines>

  <media>
    <led id="leds" index="grid" grid_size="1,1,1" />
    <range_and_bearing id="rab" index="grid" grid_size="1,1,1" />
  </media>

</argos-configuration>